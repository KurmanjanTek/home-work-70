@model MyChat.Web.ViewModels.EditProfileViewModel

<h1> Редактирование профиля</h1>
<a asp-controller="User" asp-action="Edit" method="post" enctype="multipart/form-data">
    <label asp-for="UserName"></label>
    <input asp-for="UserName" />
    
    <label asp-for="Email"></label>
    <input asp-for="Email" />
    
    <label asp-for="BirthOfDate"></label>
    <input asp-for="BirthOfDate" type="date" />
    
    <label asp-for="Avatar"></label>
    <input asp-for="Avatar" type="file" accept=".jpg,.jpeg,.png,.jfif"/>
    
    <button type="submit">Сохранить</button>

    
    <a asp-controller="User" asp-action="ChangePassword" method="post" class="btn-outline-success" > Изменить пароль</a>
</a>